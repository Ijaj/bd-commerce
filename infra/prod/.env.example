# Template for infra/prod/.env. Do not edit secrets by hand: run ./gen-secrets.sh, which writes
# infra/prod/.env (mode 600) and refuses to overwrite an existing one.
# Values with `$` are single-quoted so compose does not interpolate them.

# Public hostnames: BASE_DOMAIN, www./admin./sr./img./api./mail. subdomains. No domain yet: use
# bdc.localhost with PUBLIC_SCHEME=http (*.localhost resolves to 127.0.0.1 in browsers and curl).
BASE_DOMAIN=bdc.localhost
PUBLIC_SCHEME=http
# Production (C96): the PC has a public static IP; DNS A records for BASE_DOMAIN and the
# www./admin./sr./img./api./mail. subdomains point at it. Set BASE_DOMAIN=yourshop.com and
# PUBLIC_SCHEME=https: Caddy then gets Let's Encrypt certificates by itself and redirects http to https.
# Router: forward external port 80 -> this PC's HTTP_PORT and 443 -> this PC's HTTPS_PORT.
# Rootless Podman cannot bind ports below 1024, hence 8088/8443. Alternative: run
#   sudo sysctl -w net.ipv4.ip_unprivileged_port_start=80
# (persist it in /etc/sysctl.d/), set HTTP_PORT=80 and HTTPS_PORT=443, and forward 80/443 straight through.
# HTTP_BIND: 127.0.0.1 = this PC only (local test). Use 0.0.0.0 in production so the router can reach it.
HTTP_BIND=127.0.0.1
HTTP_PORT=8088
HTTPS_PORT=8443
# Contact address for Let's Encrypt expiry notices (optional but recommended in production).
ACME_EMAIL=
# Fixed compose network; the API trusts proxy headers only from this subnet.
PROD_SUBNET=10.99.77.0/24

POSTGRES_PASSWORD=
GARAGE_RPC_SECRET=
GARAGE_ADMIN_TOKEN=
# Garage S3 key (imported by init.sh): id = GK + 24 hex, secret = 64 hex.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
IMGPROXY_KEY=
IMGPROXY_SALT=
# 32-byte hex keys. Losing STAFF_TOTP_KEY locks staff out of 2FA; losing AFFILIATE_PAYOUT_KEY
# makes saved payout details unreadable. Back this file up (backup.sh does not include it).
STAFF_TOTP_KEY=
AFFILIATE_PAYOUT_KEY=
OTP_SECRET=

# Mailpit web UI (mail.<domain>) behind basic auth: user "staff". Hash = bcrypt of the password.
MAIL_UI_PASSWORD=
MAIL_UI_HASH=
MAIL_FROM=BD Commerce <no-reply@bdc.localhost>

# Optional courier credentials (C51). Without keys a courier cannot book; the fake one needs none.
STEADFAST_API_KEY=
STEADFAST_SECRET_KEY=
STEADFAST_WEBHOOK_TOKEN=
PATHAO_CLIENT_ID=
PATHAO_CLIENT_SECRET=
PATHAO_USERNAME=
PATHAO_PASSWORD=
PATHAO_STORE_ID=
PATHAO_WEBHOOK_SECRET=
