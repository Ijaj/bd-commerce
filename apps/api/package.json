{
  "name": "@bdc/api",
  "private": true,
  "scripts": {
    "prisma:generate": "prisma generate",
    "build": "prisma generate && rm -rf dist && swc src -d dist --strip-leading-paths",
    "dev": "prisma generate && swc src -d dist --strip-leading-paths && concurrently -k -n swc,api \"swc src -d dist --strip-leading-paths -w\" \"node --watch --enable-source-maps dist/main.js\"",
    "start": "node --enable-source-maps dist/main.js",
    "typecheck": "prisma generate && tsc --noEmit",
    "test": "prisma generate && vitest run",
    "migrate:dev": "prisma migrate dev",
    "openapi": "pnpm build && node dist/openapi-emit.js ../../packages/api-client/openapi.json",
    "cli": "node --enable-source-maps dist/cli.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1155.0",
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-express": "11.2.7",
    "@nestjs/swagger": "11.4.7",
    "@node-rs/argon2": "2.2.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "cookie-parser": "1.4.7",
    "exceljs": "4.4.0",
    "ioredis": "5.11.1",
    "nestjs-zod": "5.5.0",
    "nodemailer": "10.2.1",
    "otpauth": "9.5.2",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sanitize-html": "2.18.1",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "11.2.7",
    "@swc/cli": "0.8.1",
    "@swc/core": "1.16.20",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/multer": "2.3.0",
    "@types/node": "24.19.2",
    "@types/nodemailer": "8.0.2",
    "@types/sanitize-html": "2.16.2",
    "@types/supertest": "7.2.1",
    "chokidar": "5.0.0",
    "concurrently": "10.0.6",
    "prisma": "7.10.1",
    "supertest": "7.3.1",
    "typescript": "7.0.2",
    "unplugin-swc": "2.0.0",
    "vitest": "5.0.5"
  }
}
