// Tables follow plan/12-data-model.md. Step 1: staff, sessions, RBAC, settings. Step 2: catalog + inventory.
// Step 3: customers, customer sessions, OTP codes, wishlists, carousel slides.
// Step 4: BD geo, delivery zones, addresses, carts, orders, payments. Step 7: SR/B2B, suppliers, POs.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

/// Staff accounts (doc 12 §1, Q68, C13–C16). Never deleted: disabled_at instead.
model Staff {
  id                String    @id @default(uuid(7)) @db.Uuid
  name              String
  email             String    @unique
  phone             String?
  passwordHash      String    @map("password_hash")
  /// AES-256-GCM encrypted TOTP secret. Set at 2FA setup, active once totp_enabled_at is set.
  totpSecret        String?   @map("totp_secret")
  totpEnabledAt     DateTime? @map("totp_enabled_at") @db.Timestamptz
  /// Last accepted TOTP time step; codes at or before it are rejected (replay guard).
  totpLastStep      Int?      @map("totp_last_step")
  /// Last 2FA reset by another staff member (C14). Full audit log is not in P1.
  totpResetAt       DateTime? @map("totp_reset_at") @db.Timestamptz
  totpResetById     String?   @map("totp_reset_by_id") @db.Uuid
  disabledAt        DateTime? @map("disabled_at") @db.Timestamptz
  lastLoginAt       DateTime? @map("last_login_at") @db.Timestamptz
  /// Idle timeout override; null = default setting (C16).
  sessionTimeoutMin Int?      @map("session_timeout_min")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  totpResetBy     Staff?                   @relation("TotpReset", fields: [totpResetById], references: [id])
  totpResets      Staff[]                  @relation("TotpReset")
  sessions        StaffSession[]
  devices         StaffKnownDevice[]
  backupCodes     StaffBackupCode[]
  roles           StaffRole[]
  settings        Setting[]
  media           Media[]
  stockMoves      StockMovement[]
  srProfile       SrProfile?
  srSales         SrSale[]                 @relation("SrSaleSr")
  srApprovals     SrSale[]                 @relation("SrSaleApprover")
  srDeliveries    SrSale[]                 @relation("SrSaleDeliverer")
  b2bShopsCreated B2bShop[]
  ledgerRecorded  B2bLedger[]              @relation("LedgerRecordedBy")
  ledgerConfirmed B2bLedger[]              @relation("LedgerConfirmedBy")
  ledgerRejected  B2bLedger[]              @relation("LedgerRejectedBy")
  srReversals     SrSale[]                 @relation("SrSaleReverser")
  srCommissionAdj SrCommissionAdjustment[] @relation("SrCommissionAdjSr")
  srTargets       SrTarget[]
  srCommissions   SrCommission[]
  purchaseOrders  PurchaseOrder[]

  @@map("staff")
}

model StaffSession {
  id            String    @id @default(uuid(7)) @db.Uuid
  staffId       String    @map("staff_id") @db.Uuid
  tokenHash     String    @unique @map("token_hash")
  /// Null until the 2FA step passes; until then only 2FA endpoints are allowed.
  mfaVerifiedAt DateTime? @map("mfa_verified_at") @db.Timestamptz
  mfaAttempts   Int       @default(0) @map("mfa_attempts")
  ip            String?
  userAgent     String?   @map("user_agent")
  lastSeenAt    DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz

  staff Staff @relation(fields: [staffId], references: [id])

  @@index([staffId])
  @@map("staff_sessions")
}

/// Devices seen at login, keyed by a long-lived random device cookie (new-device alert, Q68).
model StaffKnownDevice {
  id              String   @id @default(uuid(7)) @db.Uuid
  staffId         String   @map("staff_id") @db.Uuid
  fingerprintHash String   @map("fingerprint_hash")
  userAgent       String?  @map("user_agent")
  firstSeenAt     DateTime @default(now()) @map("first_seen_at") @db.Timestamptz
  lastSeenAt      DateTime @default(now()) @map("last_seen_at") @db.Timestamptz

  staff Staff @relation(fields: [staffId], references: [id])

  @@unique([staffId, fingerprintHash])
  @@map("staff_known_devices")
}

/// One-time 2FA backup codes (C14), hashed.
model StaffBackupCode {
  id       String    @id @default(uuid(7)) @db.Uuid
  staffId  String    @map("staff_id") @db.Uuid
  codeHash String    @map("code_hash")
  usedAt   DateTime? @map("used_at") @db.Timestamptz

  staff Staff @relation(fields: [staffId], references: [id])

  @@index([staffId])
  @@map("staff_backup_codes")
}

/// Permission catalog, synced from code at startup (doc 12 §2). Not editable.
model Permission {
  key         String @id
  group       String
  description String

  roles RolePermission[]

  @@map("permissions")
}

model Role {
  id          String   @id @default(uuid(7)) @db.Uuid
  name        String   @unique
  description String?
  /// Owner role: cannot be deleted or edited, always has every permission.
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  permissions RolePermission[]
  staff       StaffRole[]

  @@map("roles")
}

model RolePermission {
  roleId        String @map("role_id") @db.Uuid
  permissionKey String @map("permission_key")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionKey], references: [key], onDelete: Cascade)

  @@id([roleId, permissionKey])
  @@map("role_permissions")
}

model StaffRole {
  staffId String @map("staff_id") @db.Uuid
  roleId  String @map("role_id") @db.Uuid

  staff Staff @relation(fields: [staffId], references: [id])
  role  Role  @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([staffId, roleId])
  @@index([roleId])
  @@map("staff_roles")
}

/// Admin-edited overrides only; keys, types and defaults live in code (src/settings/registry.ts, C19).
model Setting {
  key         String   @id
  value       Json
  updatedById String?  @map("updated_by_id") @db.Uuid
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  updatedBy Staff? @relation(fields: [updatedById], references: [id])

  @@map("settings")
}

// ---------------------------------------------------------------------------
// Catalog (doc 12 §3). Bilingual text = `*_en` + optional `*_bn` (falls back to EN).
// Money = integer paisa, columns end in `_p`.
// ---------------------------------------------------------------------------

/// Seller-ready (Q2): one row (us) now; marketplace later adds rows.
model Seller {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String
  status    String   @default("active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  products Product[]

  @@map("sellers")
}

/// Uploaded files in Garage (S31). Resized on view by imgproxy, so no stored renditions.
model Media {
  id           String   @id @default(uuid(7)) @db.Uuid
  storageKey   String   @unique @map("storage_key")
  mime         String
  width        Int
  height       Int
  bytes        Int
  alt          String?
  uploadedById String?  @map("uploaded_by_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  uploadedBy      Staff?          @relation(fields: [uploadedById], references: [id])
  brandLogos      Brand[]
  categoryImages  Category[]      @relation("CategoryImage")
  categoryIcons   Category[]      @relation("CategoryIcon")
  categoryBanners Category[]      @relation("CategoryBanner")
  productImages   ProductImage[]
  slidesDesktop   CarouselSlide[] @relation("SlideDesktop")
  slidesMobile    CarouselSlide[] @relation("SlideMobile")

  @@map("media")
}

model Brand {
  id          String   @id @default(uuid(7)) @db.Uuid
  nameEn      String   @map("name_en")
  nameBn      String?  @map("name_bn")
  slug        String   @unique
  logoMediaId String?  @map("logo_media_id") @db.Uuid
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  logo     Media?    @relation(fields: [logoMediaId], references: [id], onDelete: Restrict)
  products Product[]

  @@map("brands")
}

/// Category tree, max 4 levels (Q19). `path` = materialized ancestor ids incl. self,
/// e.g. `/a/b/c/`, so "category + descendants" is one prefix query.
model Category {
  id               String   @id @default(uuid(7)) @db.Uuid
  parentId         String?  @map("parent_id") @db.Uuid
  level            Int
  path             String
  nameEn           String   @map("name_en")
  nameBn           String?  @map("name_bn")
  slug             String   @unique
  descriptionEn    String?  @map("description_en")
  descriptionBn    String?  @map("description_bn")
  /// Required at level 1 (Q20), enforced in the service.
  imageMediaId     String?  @map("image_media_id") @db.Uuid
  iconMediaId      String?  @map("icon_media_id") @db.Uuid
  bannerMediaId    String?  @map("banner_media_id") @db.Uuid
  /// Chip colour under the image (Q15), hex like `#4f46e5`.
  chipColor        String?  @map("chip_color")
  sort             Int      @default(0)
  isActive         Boolean  @default(true) @map("is_active")
  showOnHome       Boolean  @default(false) @map("show_on_home")
  /// Return window override (Q59); null = inherit.
  returnWindowDays Int?     @map("return_window_days")
  seoTitle         String?  @map("seo_title")
  seoDescription   String?  @map("seo_description")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz

  parent          Category?           @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children        Category[]          @relation("CategoryTree")
  image           Media?              @relation("CategoryImage", fields: [imageMediaId], references: [id], onDelete: Restrict)
  icon            Media?              @relation("CategoryIcon", fields: [iconMediaId], references: [id], onDelete: Restrict)
  banner          Media?              @relation("CategoryBanner", fields: [bannerMediaId], references: [id], onDelete: Restrict)
  attributes      CategoryAttribute[]
  products        ProductCategory[]
  primaryProducts Product[]

  @@index([parentId])
  @@index([path])
  @@map("categories")
}

enum AttributeType {
  text
  number
  select
  multiselect
  boolean

  @@map("attribute_type")
}

/// Category attributes (Q25): inherited by sub-categories, used as filters.
model CategoryAttribute {
  id           String        @id @default(uuid(7)) @db.Uuid
  categoryId   String        @map("category_id") @db.Uuid
  key          String
  nameEn       String        @map("name_en")
  nameBn       String?       @map("name_bn")
  type         AttributeType
  unit         String?
  isFilterable Boolean       @default(true) @map("is_filterable")
  isRequired   Boolean       @default(false) @map("is_required")
  sort         Int           @default(0)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  category Category                @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  options  AttributeOption[]
  values   ProductAttributeValue[]

  @@unique([categoryId, key])
  @@map("category_attributes")
}

/// Options of select/multiselect attributes (Q116 option editor).
model AttributeOption {
  id          String  @id @default(uuid(7)) @db.Uuid
  attributeId String  @map("attribute_id") @db.Uuid
  valueEn     String  @map("value_en")
  valueBn     String? @map("value_bn")
  sort        Int     @default(0)

  attribute CategoryAttribute       @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  values    ProductAttributeValue[]

  @@index([attributeId])
  @@map("attribute_options")
}

enum ProductStatus {
  draft
  active
  archived

  @@map("product_status")
}

enum Fulfillment {
  stock
  dropship

  @@map("fulfillment")
}

model Product {
  id                      String        @id @default(uuid(7)) @db.Uuid
  sellerId                String        @map("seller_id") @db.Uuid
  brandId                 String?       @map("brand_id") @db.Uuid
  primaryCategoryId       String        @map("primary_category_id") @db.Uuid
  titleEn                 String        @map("title_en")
  titleBn                 String?       @map("title_bn")
  slug                    String        @unique
  shortDescriptionEn      String?       @map("short_description_en")
  shortDescriptionBn      String?       @map("short_description_bn")
  /// Sanitized on save and on render (Q28).
  descriptionHtmlEn       String?       @map("description_html_en")
  descriptionHtmlBn       String?       @map("description_html_bn")
  youtubeUrl              String?       @map("youtube_url")
  status                  ProductStatus @default(draft)
  archivedAt              DateTime?     @map("archived_at") @db.Timestamptz
  fulfillment             Fulfillment   @default(stock)
  hasVariants             Boolean       @default(false) @map("has_variants")
  weightG                 Int?          @map("weight_g")
  deliveryChargeOverrideP Int?          @map("delivery_charge_override_p")
  returnWindowDays        Int?          @map("return_window_days")
  isPreorder              Boolean       @default(false) @map("is_preorder")
  preorderExpectedDate    DateTime?     @map("preorder_expected_date") @db.Date
  /// Visible, no cart/buy, wishlist only (Q114).
  isUpcoming              Boolean       @default(false) @map("is_upcoming")
  /// Requires advance X% (Q106, P2 flag).
  advancePercent          Int?          @map("advance_percent")
  /// Basis points override, unused in v1 (Q95).
  vatRateBp               Int?          @map("vat_rate_bp")
  isPinned                Boolean       @default(false) @map("is_pinned")
  pinBoost                Int           @default(0) @map("pin_boost")
  ratingAvg               Decimal       @default(0) @map("rating_avg") @db.Decimal(3, 2)
  ratingCount             Int           @default(0) @map("rating_count")
  soldCount               Int           @default(0) @map("sold_count")
  viewCount               Int           @default(0) @map("view_count")
  seoTitle                String?       @map("seo_title")
  seoDescription          String?       @map("seo_description")
  publishedAt             DateTime?     @map("published_at") @db.Timestamptz
  createdAt               DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt               DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  seller          Seller                  @relation(fields: [sellerId], references: [id])
  brand           Brand?                  @relation(fields: [brandId], references: [id], onDelete: SetNull)
  primaryCategory Category                @relation(fields: [primaryCategoryId], references: [id])
  categories      ProductCategory[]
  attributeValues ProductAttributeValue[]
  options         ProductOption[]
  images          ProductImage[]
  variants        Variant[]
  wishlists       Wishlist[]
  orderItems      OrderItem[]

  @@index([status])
  @@index([brandId])
  @@index([primaryCategoryId])
  @@map("products")
}

/// Product ↔ category, any level (Q21/Q22). The primary category is listed here too.
model ProductCategory {
  productId  String @map("product_id") @db.Uuid
  categoryId String @map("category_id") @db.Uuid

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@index([categoryId])
  @@map("product_categories")
}

/// One row per value; multiselect = several rows.
model ProductAttributeValue {
  id          String   @id @default(uuid(7)) @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  attributeId String   @map("attribute_id") @db.Uuid
  valueText   String?  @map("value_text")
  valueNumber Decimal? @map("value_number") @db.Decimal(14, 4)
  valueBool   Boolean? @map("value_bool")
  optionId    String?  @map("option_id") @db.Uuid

  product   Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  attribute CategoryAttribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  option    AttributeOption?  @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([attributeId, optionId])
  @@map("product_attribute_values")
}

/// Variant option types, max 2 per product (Q24), e.g. Color × Size.
model ProductOption {
  id        String  @id @default(uuid(7)) @db.Uuid
  productId String  @map("product_id") @db.Uuid
  /// 1 or 2
  position  Int
  nameEn    String  @map("name_en")
  nameBn    String? @map("name_bn")

  product Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  values  ProductOptionValue[]

  @@unique([productId, position])
  @@map("product_options")
}

model ProductOptionValue {
  id        String  @id @default(uuid(7)) @db.Uuid
  optionId  String  @map("option_id") @db.Uuid
  valueEn   String  @map("value_en")
  valueBn   String? @map("value_bn")
  swatchHex String? @map("swatch_hex")
  sort      Int     @default(0)

  option    ProductOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  variants1 Variant[]     @relation("VariantOption1")
  variants2 Variant[]     @relation("VariantOption2")

  @@index([optionId])
  @@map("product_option_values")
}

/// variantId null = shared image for all variants.
model ProductImage {
  id        String  @id @default(uuid(7)) @db.Uuid
  productId String  @map("product_id") @db.Uuid
  variantId String? @map("variant_id") @db.Uuid
  mediaId   String  @map("media_id") @db.Uuid
  sort      Int     @default(0)
  alt       String?

  product Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant Variant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  media   Media    @relation(fields: [mediaId], references: [id])

  @@index([productId])
  @@map("product_images")
}

/// Every product has ≥1 variant; a simple product has one default variant (no option values).
/// Price and stock always live here.
model Variant {
  id             String    @id @default(uuid(7)) @db.Uuid
  productId      String    @map("product_id") @db.Uuid
  sku            String    @unique
  barcode        String?
  optionValue1Id String?   @map("option_value_1_id") @db.Uuid
  optionValue2Id String?   @map("option_value_2_id") @db.Uuid
  priceP         Int       @map("price_p")
  /// Old price shown struck through.
  compareAtP     Int?      @map("compare_at_p")
  salePriceP     Int?      @map("sale_price_p")
  saleStartsAt   DateTime? @map("sale_starts_at") @db.Timestamptz
  saleEndsAt     DateTime? @map("sale_ends_at") @db.Timestamptz
  /// Last cost; admin-only (products.view_cost).
  costP          Int?      @map("cost_p")
  weightG        Int?      @map("weight_g")
  isActive       Boolean   @default(true) @map("is_active")
  sort           Int       @default(0)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  product      Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  optionValue1 ProductOptionValue? @relation("VariantOption1", fields: [optionValue1Id], references: [id], onDelete: Restrict)
  optionValue2 ProductOptionValue? @relation("VariantOption2", fields: [optionValue2Id], references: [id], onDelete: Restrict)
  images       ProductImage[]
  inventory    Inventory?
  movements    StockMovement[]
  cartItems    CartItem[]
  orderItems   OrderItem[]
  srSaleItems  SrSaleItem[]
  suppliers    VariantSupplier[]
  poItems      PurchaseOrderItem[]

  @@unique([productId, optionValue1Id, optionValue2Id])
  @@map("variants")
}

/// One warehouse (Q60). Available = on_hand − reserved. Change only via stock_movements.
model Inventory {
  variantId         String   @id @map("variant_id") @db.Uuid
  onHand            Int      @default(0) @map("on_hand")
  reserved          Int      @default(0)
  lowStockThreshold Int?     @map("low_stock_threshold")
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz

  variant Variant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@map("inventory")
}

enum StockReason {
  po_receive
  order_reserve
  order_release
  ship
  return_restock
  adjust
  import
  sr_reserve
  sr_release
  sr_ship

  @@map("stock_reason")
}

/// Append-only stock ledger: never updated or deleted (DB trigger blocks UPDATE/DELETE).
model StockMovement {
  id            String      @id @default(uuid(7)) @db.Uuid
  variantId     String      @map("variant_id") @db.Uuid
  qtyDelta      Int         @default(0) @map("qty_delta")
  reservedDelta Int         @default(0) @map("reserved_delta")
  reason        StockReason
  refType       String?     @map("ref_type")
  refId         String?     @map("ref_id")
  staffId       String?     @map("staff_id") @db.Uuid
  note          String?
  at            DateTime    @default(now()) @db.Timestamptz

  /// Restrict: a variant with ledger history can't be deleted (archive/deactivate instead).
  variant Variant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  staff   Staff?  @relation(fields: [staffId], references: [id])

  @@index([variantId, at])
  @@map("stock_movements")
}

// ---------------------------------------------------------------------------
// Customers (doc 12 §1, Q33/Q33b, Q91). Separate from staff. Never deleted: disabled_at.
// Step 3 = phone/email + password + SMS OTP; social logins come later (C27).
// ---------------------------------------------------------------------------

enum Lang {
  en
  bn

  @@map("lang")
}

model Customer {
  id              String    @id @default(uuid(7)) @db.Uuid
  name            String
  /// Normalized BD mobile `01XXXXXXXXX` (11 digits).
  phone           String?   @unique
  phoneVerifiedAt DateTime? @map("phone_verified_at") @db.Timestamptz
  /// Lower-cased.
  email           String?   @unique
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz
  /// Argon2id. Null only for future social-login-only accounts.
  passwordHash    String?   @map("password_hash")
  lang            Lang      @default(en)
  /// Risky customer → advance required (Q106, P2).
  isFlagged       Boolean   @default(false) @map("is_flagged")
  disabledAt      DateTime? @map("disabled_at") @db.Timestamptz
  lastLoginAt     DateTime? @map("last_login_at") @db.Timestamptz
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  sessions  CustomerSession[]
  wishlists Wishlist[]
  addresses CustomerAddress[]
  carts     Cart[]
  orders    Order[]

  @@map("customers")
}

model CustomerSession {
  id         String    @id @default(uuid(7)) @db.Uuid
  customerId String    @map("customer_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  ip         String?
  userAgent  String?   @map("user_agent")
  lastSeenAt DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz

  customer Customer @relation(fields: [customerId], references: [id])

  @@index([customerId])
  @@map("customer_sessions")
}

enum OtpPurpose {
  signup
  reset
  guest_cod
  phone_change

  @@map("otp_purpose")
}

/// SMS one-time codes (Q33b, Q81). Hashed; limited attempts; single use.
model OtpCode {
  id        String     @id @default(uuid(7)) @db.Uuid
  purpose   OtpPurpose
  phone     String
  codeHash  String     @map("code_hash")
  attempts  Int        @default(0)
  expiresAt DateTime   @map("expires_at") @db.Timestamptz
  usedAt    DateTime?  @map("used_at") @db.Timestamptz
  ip        String?
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz

  @@index([phone, purpose, createdAt])
  @@map("otp_codes")
}

/// Wishlist needs login (C29). Per product (variant picked at add-to-cart).
model Wishlist {
  id         String   @id @default(uuid(7)) @db.Uuid
  customerId String   @map("customer_id") @db.Uuid
  productId  String   @map("product_id") @db.Uuid
  addedAt    DateTime @default(now()) @map("added_at") @db.Timestamptz

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([customerId, productId])
  @@index([productId])
  @@map("wishlists")
}

// ---------------------------------------------------------------------------
// Home page (doc 02 Carousel, doc 12 §14). Featured categories = categories.show_on_home.
// ---------------------------------------------------------------------------

enum SlideLang {
  all
  en
  bn

  @@map("slide_lang")
}

model CarouselSlide {
  id                  String    @id @default(uuid(7)) @db.Uuid
  title               String
  imageDesktopMediaId String    @map("image_desktop_media_id") @db.Uuid
  imageMobileMediaId  String?   @map("image_mobile_media_id") @db.Uuid
  /// Relative shop path (`/p/slug`, `/c/slug`) or absolute URL.
  linkUrl             String?   @map("link_url")
  startsAt            DateTime? @map("starts_at") @db.Timestamptz
  endsAt              DateTime? @map("ends_at") @db.Timestamptz
  sort                Int       @default(0)
  isActive            Boolean   @default(true) @map("is_active")
  lang                SlideLang @default(all)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  imageDesktop Media  @relation("SlideDesktop", fields: [imageDesktopMediaId], references: [id], onDelete: Restrict)
  imageMobile  Media? @relation("SlideMobile", fields: [imageMobileMediaId], references: [id], onDelete: Restrict)

  @@map("carousel_slides")
}

// ---------------------------------------------------------------------------
// BD geo + delivery zones (doc 12 §9, Q50, Q85, Q105, C33). Geo ids come from the seed dataset.
// ---------------------------------------------------------------------------

model Division {
  id     Int    @id
  nameEn String @map("name_en")
  nameBn String @map("name_bn")

  districts District[]

  @@map("divisions")
}

model District {
  id         Int    @id
  divisionId Int    @map("division_id")
  nameEn     String @map("name_en")
  nameBn     String @map("name_bn")

  division  Division          @relation(fields: [divisionId], references: [id])
  upazilas  Upazila[]
  zones     ZoneLocation[]
  addresses CustomerAddress[]

  @@index([divisionId])
  @@map("districts")
}

model Upazila {
  id         Int    @id
  districtId Int    @map("district_id")
  nameEn     String @map("name_en")
  nameBn     String @map("name_bn")

  district  District          @relation(fields: [districtId], references: [id])
  areas     Area[]
  zones     ZoneLocation[]
  addresses CustomerAddress[]

  @@index([districtId])
  @@map("upazilas")
}

/// Optional finer level (city areas / unions), filled later for courier area lists.
model Area {
  id        Int    @id @default(autoincrement())
  upazilaId Int    @map("upazila_id")
  nameEn    String @map("name_en")
  nameBn    String @map("name_bn")

  upazila   Upazila           @relation(fields: [upazilaId], references: [id])
  zones     ZoneLocation[]
  addresses CustomerAddress[]

  @@index([upazilaId])
  @@map("areas")
}

model DeliveryZone {
  id          String   @id @default(uuid(7)) @db.Uuid
  nameEn      String   @map("name_en")
  nameBn      String?  @map("name_bn")
  baseChargeP Int      @map("base_charge_p")
  baseWeightG Int      @default(1000) @map("base_weight_g")
  extraPerKgP Int      @default(0) @map("extra_per_kg_p")
  etaMinDays  Int      @map("eta_min_days")
  etaMaxDays  Int      @map("eta_max_days")
  /// Q105: null = never free, 0 = always free, else free when subtotal ≥ this.
  freeAboveP  Int?     @map("free_above_p")
  /// Fallback zone for locations not matched by any zone_locations row. Exactly one.
  isDefault   Boolean  @default(false) @map("is_default")
  sort        Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  locations ZoneLocation[]
  orders    Order[]

  @@map("delivery_zones")
}

/// Exactly one of district/upazila/area is set; most specific match wins.
model ZoneLocation {
  id         String @id @default(uuid(7)) @db.Uuid
  zoneId     String @map("zone_id") @db.Uuid
  districtId Int?   @map("district_id")
  upazilaId  Int?   @map("upazila_id")
  areaId     Int?   @map("area_id")

  zone     DeliveryZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  district District?    @relation(fields: [districtId], references: [id])
  upazila  Upazila?     @relation(fields: [upazilaId], references: [id])
  area     Area?        @relation(fields: [areaId], references: [id])

  @@unique([districtId])
  @@unique([upazilaId])
  @@unique([areaId])
  @@map("zone_locations")
}

model CustomerAddress {
  id         String   @id @default(uuid(7)) @db.Uuid
  customerId String   @map("customer_id") @db.Uuid
  label      String?
  name       String
  phone      String
  districtId Int      @map("district_id")
  upazilaId  Int      @map("upazila_id")
  areaId     Int?     @map("area_id")
  line       String
  landmark   String?
  isDefault  Boolean  @default(false) @map("is_default")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  district District @relation(fields: [districtId], references: [id])
  upazila  Upazila  @relation(fields: [upazilaId], references: [id])
  area     Area?    @relation(fields: [areaId], references: [id])

  @@index([customerId])
  @@map("customer_addresses")
}

// ---------------------------------------------------------------------------
// Cart (doc 12 §6, C35). Guest cart keyed by visitor cookie; merged into the customer cart on login.
// ---------------------------------------------------------------------------

model Cart {
  id                  String    @id @default(uuid(7)) @db.Uuid
  customerId          String?   @map("customer_id") @db.Uuid
  visitorId           String?   @map("visitor_id")
  platform            String    @default("web")
  lastActivityAt      DateTime  @default(now()) @map("last_activity_at") @db.Timestamptz
  abandonedNotifiedAt DateTime? @map("abandoned_notified_at") @db.Timestamptz
  /// Set when this guest cart was merged into a customer cart; merged carts are read-only.
  mergedIntoId        String?   @map("merged_into_id") @db.Uuid
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz

  customer Customer?  @relation(fields: [customerId], references: [id])
  items    CartItem[]

  @@index([customerId])
  @@index([visitorId])
  @@map("carts")
}

model CartItem {
  id          String   @id @default(uuid(7)) @db.Uuid
  cartId      String   @map("cart_id") @db.Uuid
  variantId   String   @map("variant_id") @db.Uuid
  qty         Int
  /// Price when added, to show "price changed" in the cart.
  priceAtAddP Int      @map("price_at_add_p")
  addedAt     DateTime @default(now()) @map("added_at") @db.Timestamptz

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant Variant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([cartId, variantId])
  @@map("cart_items")
}

// ---------------------------------------------------------------------------
// Orders + payments (doc 12 §6). Snapshots: later catalog edits never change old orders.
// order_no = YYMM-NNNNN from sequence order_no_seq (C32). Shipments/couriers/invoices come in step 5.
// ---------------------------------------------------------------------------

enum OrderStatus {
  pending_payment
  processing
  on_hold
  partially_shipped
  shipped
  delivered
  completed
  cancelled

  @@map("order_status")
}

enum PaymentStatus {
  unpaid
  partially_paid
  paid
  partially_refunded
  refunded
  failed

  @@map("payment_status")
}

model Order {
  id                  String        @id @default(uuid(7)) @db.Uuid
  orderNo             String        @unique @map("order_no")
  customerId          String?       @map("customer_id") @db.Uuid
  guestName           String?       @map("guest_name")
  guestPhone          String?       @map("guest_phone")
  guestEmail          String?       @map("guest_email")
  visitorId           String?       @map("visitor_id")
  platform            String        @default("web")
  ip                  String?
  userAgent           String?       @map("user_agent")
  lang                Lang          @default(en)
  // Ship-to snapshot
  shipName            String        @map("ship_name")
  shipPhone           String        @map("ship_phone")
  shipDivisionId      Int           @map("ship_division_id")
  shipDistrictId      Int           @map("ship_district_id")
  shipUpazilaId       Int           @map("ship_upazila_id")
  shipAreaId          Int?          @map("ship_area_id")
  /// "Area, Upazila, District" in the order's language, frozen at placement.
  shipPlaceText       String        @map("ship_place_text")
  shipLine            String        @map("ship_line")
  shipLandmark        String?       @map("ship_landmark")
  zoneId              String        @map("zone_id") @db.Uuid
  customerNote        String?       @map("customer_note")
  // Status
  status              OrderStatus   @default(processing)
  paymentStatus       PaymentStatus @default(unpaid) @map("payment_status")
  paymentMethodChosen String        @default("cod") @map("payment_method_chosen")
  isPreorder          Boolean       @default(false) @map("is_preorder")
  cancelReason        String?       @map("cancel_reason")
  heldReason          String?       @map("held_reason")
  // Money (paisa)
  subtotalP           Int           @map("subtotal_p")
  autoDiscountP       Int           @default(0) @map("auto_discount_p")
  couponDiscountP     Int           @default(0) @map("coupon_discount_p")
  deliveryChargeP     Int           @map("delivery_charge_p")
  deliveryDiscountP   Int           @default(0) @map("delivery_discount_p")
  grandTotalP         Int           @map("grand_total_p")
  advanceRequiredP    Int           @default(0) @map("advance_required_p")
  paidP               Int           @default(0) @map("paid_p")
  refundedP           Int           @default(0) @map("refunded_p")
  codDueP             Int           @map("cod_due_p")
  // Call-confirmation queue (C53, Q53/Q54): flagged orders wait for an optional staff call; never blocks.
  riskScore           Int           @default(0) @map("risk_score")
  /// string[] of reason codes: velocity_phone | velocity_ip | velocity_device | cod_high | first_guest
  riskReasons         Json          @default("[]") @map("risk_reasons")
  callStatus          CallStatus    @default(not_needed) @map("call_status")
  callNote            String?       @map("call_note")
  callStaffId         String?       @map("call_staff_id") @db.Uuid
  callAt              DateTime?     @map("call_at") @db.Timestamptz
  // Checks
  guestOtpVerifiedAt  DateTime?     @map("guest_otp_verified_at") @db.Timestamptz
  placedAt            DateTime      @default(now()) @map("placed_at") @db.Timestamptz
  deliveredAt         DateTime?     @map("delivered_at") @db.Timestamptz
  completedAt         DateTime?     @map("completed_at") @db.Timestamptz
  createdAt           DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  customer  Customer?            @relation(fields: [customerId], references: [id])
  zone      DeliveryZone         @relation(fields: [zoneId], references: [id])
  items     OrderItem[]
  history   OrderStatusHistory[]
  payments  Payment[]
  shipments Shipment[]
  invoices  Invoice[]
  returns   Return[]
  refunds   Refund[]

  @@index([callStatus, placedAt])
  @@index([customerId])
  @@index([guestPhone])
  @@index([status, placedAt])
  @@map("orders")
}

model OrderItem {
  id               String  @id @default(uuid(7)) @db.Uuid
  orderId          String  @map("order_id") @db.Uuid
  sellerId         String  @map("seller_id") @db.Uuid
  productId        String  @map("product_id") @db.Uuid
  variantId        String  @map("variant_id") @db.Uuid
  titleSnapshot    String  @map("title_snapshot")
  sku              String
  optionsText      String? @map("options_text")
  /// Snapshot of the image shown at purchase; no FK so media cleanup never touches orders.
  imageMediaId     String? @map("image_media_id") @db.Uuid
  qty              Int
  qtyCancelled     Int     @default(0) @map("qty_cancelled")
  qtyReturned      Int     @default(0) @map("qty_returned")
  unitBaseP        Int     @map("unit_base_p")
  unitPriceP       Int     @map("unit_price_p")
  /// base | sale (flash/event come with promotions, step 6)
  priceSource      String  @map("price_source")
  weightG          Int?    @map("weight_g")
  returnWindowDays Int?    @map("return_window_days")
  lineTotalP       Int     @map("line_total_p")

  order         Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product       Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant       Variant        @relation(fields: [variantId], references: [id], onDelete: Restrict)
  shipmentItems ShipmentItem[]
  returnItems   ReturnItem[]
  refundItems   RefundItem[]

  @@index([orderId])
  @@index([variantId])
  @@map("order_items")
}

model OrderStatusHistory {
  id         String       @id @default(uuid(7)) @db.Uuid
  orderId    String       @map("order_id") @db.Uuid
  fromStatus OrderStatus? @map("from_status")
  toStatus   OrderStatus  @map("to_status")
  /// staff | customer | system
  actorType  String       @map("actor_type")
  actorId    String?      @map("actor_id") @db.Uuid
  note       String?
  at         DateTime     @default(now()) @db.Timestamptz

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, at])
  @@map("order_status_history")
}

model Payment {
  id            String    @id @default(uuid(7)) @db.Uuid
  orderId       String    @map("order_id") @db.Uuid
  /// cod | bkash | nagad | gateway | wallet (P1: cod only)
  method        String
  /// full | advance | balance | delivery_charge
  purpose       String
  amountP       Int       @map("amount_p")
  /// initiated | success | failed | cancelled | expired
  status        String    @default("initiated")
  provider      String?
  providerTxnId String?   @map("provider_txn_id")
  initiatedAt   DateTime  @default(now()) @map("initiated_at") @db.Timestamptz
  paidAt        DateTime? @map("paid_at") @db.Timestamptz

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("payments")
}

// ---------------------------------------------------------------------------
// Step 5 order operations (doc 12 §6–7, C51–C54). Staff actor columns are plain uuids (no FK),
// like orders.call_staff_id. Numbers: shipment_no SHP-YYMM-NNNNN, invoice_no INV-YYMM-NNNNN,
// return_no RET-YYMM-NNNNN, from sequences shipment_no_seq / invoice_no_seq / return_no_seq.
// ---------------------------------------------------------------------------

enum CallStatus {
  not_needed
  pending
  confirmed
  unreachable
  cancelled

  @@map("call_status")
}

enum ShipmentSource {
  warehouse
  supplier

  @@map("shipment_source")
}

enum ShipmentStatus {
  pending
  awaiting_supplier
  supplier_confirmed
  ready
  booked
  handed_over
  in_transit
  delivered
  failed
  returning
  returned
  cancelled

  @@map("shipment_status")
}

enum BookingStatus {
  requested
  booked
  failed
  cancelled

  @@map("booking_status")
}

model Courier {
  id        String   @id @default(uuid(7)) @db.Uuid
  /// Adapter key: steadfast | pathao | fake
  code      String   @unique
  name      String
  isActive  Boolean  @default(true) @map("is_active")
  /// Non-secret config only; API keys come from env.
  config    Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  shipments Shipment[]
  bookings  CourierBooking[]

  @@map("couriers")
}

model Shipment {
  id                   String         @id @default(uuid(7)) @db.Uuid
  orderId              String         @map("order_id") @db.Uuid
  shipmentNo           String         @unique @map("shipment_no")
  sellerId             String         @map("seller_id") @db.Uuid
  source               ShipmentSource @default(warehouse)
  supplierId           String?        @map("supplier_id") @db.Uuid
  status               ShipmentStatus @default(pending)
  weightG              Int?           @map("weight_g")
  /// Cash the courier collects. Whole delivery charge sits on the first shipment sent (Q92).
  codAmountP           Int            @default(0) @map("cod_amount_p")
  deliveryChargeShareP Int            @default(0) @map("delivery_charge_share_p")
  courierId            String?        @map("courier_id") @db.Uuid
  consignmentId        String?        @map("consignment_id")
  trackingUrl          String?        @map("tracking_url")
  note                 String?
  packedAt             DateTime?      @map("packed_at") @db.Timestamptz
  handedAt             DateTime?      @map("handed_at") @db.Timestamptz
  deliveredAt          DateTime?      @map("delivered_at") @db.Timestamptz
  createdAt            DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  order    Order            @relation(fields: [orderId], references: [id], onDelete: Restrict)
  courier  Courier?         @relation(fields: [courierId], references: [id])
  items    ShipmentItem[]
  bookings CourierBooking[]

  @@index([orderId])
  @@index([status])
  @@index([consignmentId])
  @@map("shipments")
}

model ShipmentItem {
  id          String @id @default(uuid(7)) @db.Uuid
  shipmentId  String @map("shipment_id") @db.Uuid
  orderItemId String @map("order_item_id") @db.Uuid
  qty         Int

  shipment  Shipment  @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)

  @@unique([shipmentId, orderItemId])
  @@index([orderItemId])
  @@map("shipment_items")
}

model CourierBooking {
  id            String        @id @default(uuid(7)) @db.Uuid
  shipmentId    String        @map("shipment_id") @db.Uuid
  courierId     String        @map("courier_id") @db.Uuid
  /// warehouse | supplier (pickup point)
  pickup        String        @default("warehouse")
  /// delivery | return (return pickups for step-5 returns)
  direction     String        @default("delivery")
  request       Json?
  response      Json?
  consignmentId String?       @map("consignment_id")
  status        BookingStatus @default(requested)
  attempt       Int           @default(1)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz

  shipment Shipment             @relation(fields: [shipmentId], references: [id], onDelete: Restrict)
  courier  Courier              @relation(fields: [courierId], references: [id])
  events   CourierStatusEvent[]

  @@index([shipmentId])
  @@index([consignmentId])
  @@map("courier_bookings")
}

model CourierStatusEvent {
  id           String   @id @default(uuid(7)) @db.Uuid
  bookingId    String   @map("booking_id") @db.Uuid
  rawStatus    String   @map("raw_status")
  mappedStatus String?  @map("mapped_status")
  payload      Json?
  at           DateTime @default(now()) @db.Timestamptz

  booking CourierBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId, at])
  @@map("courier_status_events")
}

model Invoice {
  id          String   @id @default(uuid(7)) @db.Uuid
  orderId     String   @map("order_id") @db.Uuid
  invoiceNo   String   @unique @map("invoice_no")
  issuedAt    DateTime @default(now()) @map("issued_at") @db.Timestamptz
  /// VAT-inclusive prices (Q95): vat_total_p is the VAT portion inside grand_total_p.
  vatRateBp   Int      @map("vat_rate_bp")
  vatTotalP   Int      @map("vat_total_p")
  grandTotalP Int      @map("grand_total_p")
  binSnapshot String?  @map("bin_snapshot")
  /// Frozen print data (store info, bill-to, lines) so reprints match the first issue.
  snapshot    Json

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@map("invoices")
}

enum ReturnStatus {
  requested
  approved
  rejected
  pickup_booked
  received
  inspected
  closed

  @@map("return_status")
}

enum ReturnFault {
  ours
  customer

  @@map("return_fault")
}

enum ReturnReason {
  wrong_item
  damaged
  defective
  not_as_described
  change_of_mind
  other

  @@map("return_reason")
}

enum ReturnCondition {
  resellable
  damaged

  @@map("return_condition")
}

enum RefundMethod {
  original
  wallet

  @@map("refund_method")
}

enum RefundStatus {
  pending_approval
  approved
  rejected
  processing
  done
  failed

  @@map("refund_status")
}

model Return {
  id              String       @id @default(uuid(7)) @db.Uuid
  returnNo        String       @unique @map("return_no")
  orderId         String       @map("order_id") @db.Uuid
  customerId      String?      @map("customer_id") @db.Uuid
  status          ReturnStatus @default(requested)
  /// Decides who pays return shipping (Q87): ours = we pay, customer = customer pays.
  fault           ReturnFault?
  returnShippingP Int          @default(0) @map("return_shipping_p")
  pickupBookingId String?      @map("pickup_booking_id") @db.Uuid
  staffId         String?      @map("staff_id") @db.Uuid
  note            String?
  rejectReason    String?      @map("reject_reason")
  requestedAt     DateTime     @default(now()) @map("requested_at") @db.Timestamptz
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  order   Order         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  items   ReturnItem[]
  media   ReturnMedia[]
  refunds Refund[]

  @@index([orderId])
  @@index([status])
  @@map("returns")
}

model ReturnItem {
  id          String           @id @default(uuid(7)) @db.Uuid
  returnId    String           @map("return_id") @db.Uuid
  orderItemId String           @map("order_item_id") @db.Uuid
  qty         Int
  reason      ReturnReason
  note        String?
  condition   ReturnCondition?
  restock     Boolean          @default(false)

  return    Return    @relation(fields: [returnId], references: [id], onDelete: Cascade)
  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)

  @@index([returnId])
  @@index([orderItemId])
  @@map("return_items")
}

model ReturnMedia {
  id       String @id @default(uuid(7)) @db.Uuid
  returnId String @map("return_id") @db.Uuid
  mediaId  String @map("media_id") @db.Uuid

  return Return @relation(fields: [returnId], references: [id], onDelete: Cascade)

  @@index([returnId])
  @@map("return_media")
}

model Refund {
  id            String       @id @default(uuid(7)) @db.Uuid
  orderId       String       @map("order_id") @db.Uuid
  returnId      String?      @map("return_id") @db.Uuid
  amountP       Int          @map("amount_p")
  method        RefundMethod
  status        RefundStatus @default(pending_approval)
  needsApproval Boolean      @default(false) @map("needs_approval")
  requestedBy   String?      @map("requested_by") @db.Uuid
  approvedBy    String?      @map("approved_by") @db.Uuid
  approvedAt    DateTime?    @map("approved_at") @db.Timestamptz
  providerRef   String?      @map("provider_ref")
  note          String?
  doneAt        DateTime?    @map("done_at") @db.Timestamptz
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz

  order  Order        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  return Return?      @relation(fields: [returnId], references: [id])
  items  RefundItem[]

  @@index([orderId])
  @@index([returnId])
  @@index([status])
  @@map("refunds")
}

model RefundItem {
  id          String @id @default(uuid(7)) @db.Uuid
  refundId    String @map("refund_id") @db.Uuid
  orderItemId String @map("order_item_id") @db.Uuid
  qty         Int
  amountP     Int    @map("amount_p")

  refund    Refund    @relation(fields: [refundId], references: [id], onDelete: Cascade)
  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)

  @@index([refundId])
  @@map("refund_items")
}

// ---------------------------------------------------------------------------
// SR / B2B sales (doc 12 §8b, R10–R20, Q119, Q120). SRs are staff with an sr_profile.
// memo_no = SR-YYMM-NNNNN from sequence sr_memo_no_seq.
// ---------------------------------------------------------------------------

model SrProfile {
  staffId      String   @id @map("staff_id") @db.Uuid
  area         String?
  /// Basis points; null = store default setting.
  commissionBp Int?     @map("commission_bp")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  staff Staff @relation(fields: [staffId], references: [id])

  @@map("sr_profiles")
}

model B2bShop {
  id          String   @id @default(uuid(7)) @db.Uuid
  name        String
  ownerName   String?  @map("owner_name")
  phone       String
  address     String
  area        String?
  createdById String   @map("created_by_id") @db.Uuid
  /// Added from the field; usable at once, flagged for staff review (Q119).
  isNew       Boolean  @default(true) @map("is_new")
  /// active | blocked
  status      String   @default("active")
  /// Cache of the b2b_ledger sum; ledger is the source of truth.
  dueBalanceP Int      @default(0) @map("due_balance_p")
  notes       String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  createdBy Staff       @relation(fields: [createdById], references: [id])
  sales     SrSale[]
  ledger    B2bLedger[]

  @@index([phone])
  @@map("b2b_shops")
}

enum SrSaleStatus {
  submitted
  approved
  rejected
  delivered
  cancelled
  /// Approved/delivered sale undone by staff (C43): reversing ledger entry + stock back.
  reversed

  @@map("sr_sale_status")
}

/// Who delivers an SR sale (R19, C42).
enum SrDeliveryBy {
  sr
  staff

  @@map("sr_delivery_by")
}

model SrSale {
  id             String       @id @default(uuid(7)) @db.Uuid
  memoNo         String       @unique @map("memo_no")
  srStaffId      String       @map("sr_staff_id") @db.Uuid
  b2bShopId      String       @map("b2b_shop_id") @db.Uuid
  status         SrSaleStatus @default(submitted)
  totalP         Int          @map("total_p")
  paidAtSaleP    Int          @default(0) @map("paid_at_sale_p")
  dueP           Int          @map("due_p")
  submittedAt    DateTime     @default(now()) @map("submitted_at") @db.Timestamptz
  approvedById   String?      @map("approved_by_id") @db.Uuid
  approvedAt     DateTime?    @map("approved_at") @db.Timestamptz
  rejectedReason String?      @map("rejected_reason")
  deliveredById  String?      @map("delivered_by_id") @db.Uuid
  deliveredAt    DateTime?    @map("delivered_at") @db.Timestamptz
  deliveryBy     SrDeliveryBy @default(staff) @map("delivery_by")
  reversedById   String?      @map("reversed_by_id") @db.Uuid
  reversedAt     DateTime?    @map("reversed_at") @db.Timestamptz
  reverseReason  String?      @map("reverse_reason")
  /// Public memo link token (C38); null = no link / revoked. Regenerate to revoke the old link.
  memoToken      String?      @unique @map("memo_token")
  memoTokenAt    DateTime?    @map("memo_token_at") @db.Timestamptz
  note           String?

  sr                    Staff                    @relation("SrSaleSr", fields: [srStaffId], references: [id])
  reversedBy            Staff?                   @relation("SrSaleReverser", fields: [reversedById], references: [id])
  shop                  B2bShop                  @relation(fields: [b2bShopId], references: [id])
  approvedBy            Staff?                   @relation("SrSaleApprover", fields: [approvedById], references: [id])
  deliveredBy           Staff?                   @relation("SrSaleDeliverer", fields: [deliveredById], references: [id])
  items                 SrSaleItem[]
  ledger                B2bLedger[]
  commissionAdjustments SrCommissionAdjustment[]

  @@index([srStaffId, submittedAt])
  @@index([b2bShopId])
  @@index([status])
  @@map("sr_sales")
}

model SrSaleItem {
  id         String @id @default(uuid(7)) @db.Uuid
  srSaleId   String @map("sr_sale_id") @db.Uuid
  variantId  String @map("variant_id") @db.Uuid
  qty        Int
  /// SR-entered (R15).
  unitPriceP Int    @map("unit_price_p")
  lineTotalP Int    @map("line_total_p")

  sale    SrSale  @relation(fields: [srSaleId], references: [id], onDelete: Cascade)
  variant Variant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([srSaleId])
  @@map("sr_sale_items")
}

enum LedgerType {
  sale_due
  collection
  adjustment
  /// Cancels a sale's due when the sale is reversed (C43).
  reversal

  @@map("ledger_type")
}

/// Due (baki) ledger per buyer shop (R16). amount_p: + adds due, − pays it. Append-only.
/// SR collections count once confirmed by staff (R18).
model B2bLedger {
  id            String     @id @default(uuid(7)) @db.Uuid
  b2bShopId     String     @map("b2b_shop_id") @db.Uuid
  srSaleId      String?    @map("sr_sale_id") @db.Uuid
  type          LedgerType
  amountP       Int        @map("amount_p")
  /// cash | bkash | nagad | bank
  method        String?
  recordedById  String     @map("recorded_by_id") @db.Uuid
  confirmedById String?    @map("confirmed_by_id") @db.Uuid
  confirmedAt   DateTime?  @map("confirmed_at") @db.Timestamptz
  /// Rejected collection (C43): never counted. Confirm and reject are mutually exclusive, set once.
  rejectedById  String?    @map("rejected_by_id") @db.Uuid
  rejectedAt    DateTime?  @map("rejected_at") @db.Timestamptz
  rejectReason  String?    @map("reject_reason")
  note          String?
  at            DateTime   @default(now()) @db.Timestamptz

  shop        B2bShop @relation(fields: [b2bShopId], references: [id])
  sale        SrSale? @relation(fields: [srSaleId], references: [id])
  recordedBy  Staff   @relation("LedgerRecordedBy", fields: [recordedById], references: [id])
  confirmedBy Staff?  @relation("LedgerConfirmedBy", fields: [confirmedById], references: [id])
  rejectedBy  Staff?  @relation("LedgerRejectedBy", fields: [rejectedById], references: [id])

  @@index([b2bShopId, at])
  @@map("b2b_ledger")
}

model SrTarget {
  id        String @id @default(uuid(7)) @db.Uuid
  srStaffId String @map("sr_staff_id") @db.Uuid
  /// YYYY-MM
  month     String
  targetP   Int    @map("target_p")

  sr Staff @relation(fields: [srStaffId], references: [id])

  @@unique([srStaffId, month])
  @@map("sr_targets")
}

/// Commission on money collected in the month (Q120).
model SrCommission {
  id           String    @id @default(uuid(7)) @db.Uuid
  srStaffId    String    @map("sr_staff_id") @db.Uuid
  month        String
  baseP        Int       @map("base_p")
  commissionBp Int       @map("commission_bp")
  amountP      Int       @map("amount_p")
  /// pending | approved | paid
  status       String    @default("pending")
  paidAt       DateTime? @map("paid_at") @db.Timestamptz

  sr          Staff                    @relation(fields: [srStaffId], references: [id])
  adjustments SrCommissionAdjustment[]

  @@unique([srStaffId, month])
  @@map("sr_commissions")
}

/// Commission correction (C48), e.g. a reversed sale whose commission was already approved/paid.
/// Unapplied rows (appliedToId null) are deducted by the SR's next commission run.
model SrCommissionAdjustment {
  id          String   @id @default(uuid(7)) @db.Uuid
  srStaffId   String   @map("sr_staff_id") @db.Uuid
  srSaleId    String?  @map("sr_sale_id") @db.Uuid
  /// Negative = deduction.
  amountP     Int      @map("amount_p")
  reason      String
  appliedToId String?  @map("applied_to_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  sr        Staff         @relation("SrCommissionAdjSr", fields: [srStaffId], references: [id])
  sale      SrSale?       @relation(fields: [srSaleId], references: [id])
  appliedTo SrCommission? @relation(fields: [appliedToId], references: [id])

  @@index([srStaffId, appliedToId])
  @@map("sr_commission_adjustments")
}

// ---------------------------------------------------------------------------
// Suppliers + purchasing (doc 12 §4, Q62, Q82, Q88). Receiving writes stock_movements (po_receive).
// po_no = PO-YYMM-NNNNN from sequence po_no_seq. Supplier portal users come with dropship (after step 5).
// ---------------------------------------------------------------------------

enum SupplierShipMode {
  direct_to_customer
  via_warehouse

  @@map("supplier_ship_mode")
}

model Supplier {
  id           String           @id @default(uuid(7)) @db.Uuid
  name         String
  contactName  String?          @map("contact_name")
  phone        String?
  email        String?
  address      String?
  shipMode     SupplierShipMode @default(via_warehouse) @map("ship_mode")
  paymentTerms String?          @map("payment_terms")
  notes        String?
  isActive     Boolean          @default(true) @map("is_active")
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  variants       VariantSupplier[]
  purchaseOrders PurchaseOrder[]

  @@map("suppliers")
}

model VariantSupplier {
  id           String  @id @default(uuid(7)) @db.Uuid
  variantId    String  @map("variant_id") @db.Uuid
  supplierId   String  @map("supplier_id") @db.Uuid
  supplierSku  String? @map("supplier_sku")
  costP        Int?    @map("cost_p")
  leadTimeDays Int?    @map("lead_time_days")
  isDefault    Boolean @default(false) @map("is_default")

  variant  Variant  @relation(fields: [variantId], references: [id], onDelete: Cascade)
  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([variantId, supplierId])
  @@map("variant_suppliers")
}

enum PoStatus {
  draft
  sent
  partially_received
  received
  cancelled

  @@map("po_status")
}

model PurchaseOrder {
  id          String    @id @default(uuid(7)) @db.Uuid
  poNo        String    @unique @map("po_no")
  supplierId  String    @map("supplier_id") @db.Uuid
  status      PoStatus  @default(draft)
  expectedAt  DateTime? @map("expected_at") @db.Date
  subtotalP   Int       @default(0) @map("subtotal_p")
  notes       String?
  createdById String    @map("created_by_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  supplier  Supplier            @relation(fields: [supplierId], references: [id])
  createdBy Staff               @relation(fields: [createdById], references: [id])
  items     PurchaseOrderItem[]

  @@index([supplierId])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id          String @id @default(uuid(7)) @db.Uuid
  poId        String @map("po_id") @db.Uuid
  variantId   String @map("variant_id") @db.Uuid
  qtyOrdered  Int    @map("qty_ordered")
  qtyReceived Int    @default(0) @map("qty_received")
  unitCostP   Int    @map("unit_cost_p")

  po      PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  variant Variant       @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([poId])
  @@map("purchase_order_items")
}
